# Resend (https://resend.com) — used to email contact form inquiries.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where inquiries should be delivered.
CONTACT_TO_EMAIL=hello@studiosociale.example

# Optional: sender address for outgoing inquiry emails.
# Must be on a domain verified in Resend. Defaults to Resend's
# shared test sender (onboarding@resend.dev) if not set, which
# works without any domain verification but is best for testing only.
# CONTACT_FROM_EMAIL="Studio Socialé <inquiries@yourdomain.com>"
